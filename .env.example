# nZEDb IRC Bots environment configuration

# PRE database used by post, IRC scrape, web scrape, and M2V workers.
PRE_DB_HOST=127.0.0.1
PRE_DB_PORT=3306
PRE_DB_NAME=ircpredb
PRE_DB_USER=
PRE_DB_PASSWORD=
PRE_DB_SOCKET=

# Request-ID database used by scrape-reqid and PHP/WWW/reqid.php.
REQ_DB_HOST=127.0.0.1
REQ_DB_PORT=3306
REQ_DB_NAME=reqpredb
REQ_DB_USER=
REQ_DB_PASSWORD=
REQ_DB_SOCKET=

# M2V RSS worker.
M2V_SLEEP_TIME=900
M2VRU_RSS_LINK=http://m2v.ru/?act=rss
M2VRU_THROTTLE_USLEEP=2000000

# Web source worker.
WEB_SLEEP_TIME=600
FETCH_SRRDB=false
FETCH_XREL=false
FETCH_XREL_P2P=false

# IRC posting worker.
POST_BOT_HOST=127.0.0.1
POST_BOT_PORT=6667
POST_BOT_TLS=true
POST_BOT_NICKNAME=
POST_BOT_REALNAME=
POST_BOT_USERNAME=
POST_BOT_PASSWORD=
POST_BOT_PING_STRING=
POST_BOT_DEBUG=false
POST_BOT_CHANNEL=#myPREchannel
POST_BOT_CHANNEL_PASSWORD=
POST_BOT_POST_DELAY=2
POST_BOT_SCAN_DELAY=10
POST_BOT_CLEANUP=1
POST_BOT_BOX_COLOR=
POST_BOT_INNER_COLOR=

# EFNet scraping worker.
EFNET_BOT_SERVER=127.0.0.1
EFNET_BOT_PORT=6667
EFNET_BOT_NICKNAME=
EFNET_BOT_REALNAME=
EFNET_BOT_USERNAME=
EFNET_BOT_PASSWORD=
EFNET_BOT_ENCRYPTION=false
EFNET_BOT_DEBUG=false
EFNET_BOT_CHANNELS='{"#alt.binaries.inner-sanctum":null,"#alt.binaries.cd.image":null,"#alt.binaries.movies.divx":null,"#alt.binaries.sounds.mp3.complete_cd":null,"#alt.binaries.warez":null,"#alt.binaries.console.ps3":null,"#alt.binaries.games.nintendods":null,"#alt.binaries.games.wii":null,"#alt.binaries.games.xbox360":null,"#alt.binaries.sony.psp":null,"#scnzb":null,"#tvnzb":null}'

# Corrupt-Net scraping worker.
CORRUPT_BOT_HOST=127.0.0.1
CORRUPT_BOT_PORT=6667
CORRUPT_BOT_NICKNAME=
CORRUPT_BOT_REALNAME=
CORRUPT_BOT_USERNAME=
CORRUPT_BOT_PASSWORD=
CORRUPT_BOT_ENCRYPTION=false
CORRUPT_BOT_DEBUG=false

# Request-ID scraping worker.
REQID_BOT_HOST=127.0.0.1
REQID_BOT_PORT=6667
REQID_BOT_NICKNAME=
REQID_BOT_REALNAME=
REQID_BOT_USERNAME=
REQID_BOT_PASSWORD=
REQID_BOT_ENCRYPTION=false
REQID_BOT_DEBUG=false
REQID_BOT_CHANNELS='{"#alt.binaries.inner-sanctum":null,"#alt.binaries.cd.image":null,"#alt.binaries.movies.divx":null,"#alt.binaries.sounds.mp3.complete_cd":null,"#alt.binaries.warez":null,"#alt.binaries.console.ps3":null,"#alt.binaries.games.nintendods":null,"#alt.binaries.games.wii":null,"#alt.binaries.games.xbox360":null,"#alt.binaries.sony.psp":null,"#scnzb":null,"#tvnzb":null}'
