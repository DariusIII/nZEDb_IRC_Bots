{
    "name": "dariusiii/nzedb_irc_bots",
    "description": "IRC scraper for preDB records",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "monolog/monolog": "^2.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.6.33",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
      "psr-4": {
        "App\\": "PHP/",
        "App\\Classes\\": "PHP/Classes/",
        "nzedb\\db\\": "PHP/Classes/"
      },
      "classmap": [
        "PHP/Classes/"
      ]
    },
    "autoload-dev": {
      "psr-4": {
        "Tests\\": "tests/"
      }
    },
    "bin": [
      "bin/irc-service"
    ],
    "scripts": {
      "test": "phpunit --configuration phpunit.xml.dist",
      "check-style": "phpcs",
      "fix-style": "phpcbf",
      "analyse": "phpstan analyse",
      "service": "php bin/irc-service"
    },
    "config": {
      "sort-packages": true,
      "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
  }
