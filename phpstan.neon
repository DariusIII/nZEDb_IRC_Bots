# phpstan.neon
parameters:
	level: 9
	paths:
		- PHP
	excludePaths:
		- vendor/*
		- node_modules/*
		- PHP/settings.example.php
	ignoreErrors:
		# Replace deprecated options with newer error identifiers
		-
			identifier: missingType.iterableValue
		-
			identifier: missingType.generics
		# Add specific error patterns to ignore if needed
		#- '#Call to an undefined method [a-zA-Z0-9\\_]+::[a-zA-Z0-9\\_]+\(\)#'
	tmpDir: var/cache/phpstan
	reportUnmatchedIgnoredErrors: false
	treatPhpDocTypesAsCertain: false
	bootstrapFiles:
		- phpstan-bootstrap.php
	dynamicConstantNames:
		- PHP_VERSION
		- FETCH_SRRDB
		- FETCH_XREL
		- FETCH_XREL_P2P
		- POST_BOT_BOX_COLOR
		- POST_BOT_INNER_COLOR
		- EFNET_BOT_DEBUG
		- CORRUPT_BOT_DEBUG
		- M2VRU_RSS_LINK
		- M2V_SLEEP_TIME
		- M2VRU_THROTTLE_USLEEP

includes:
	# Include additional rule sets if needed
	#- vendor/phpstan/phpstan-strict-rules/rules.neon
